//------------------------------------------------------------
// plug_pCoTCommander_vehicle.moos
//
// nsplug fragment for the per-vehicle pCoTCommander. Include
// this in each vehicle's launch configuration.
//
// REQUIRED nsplug variables (must be defined upstream):
//   $(VNAME)              -- vehicle role name, e.g. "blue_one".
//                            Used as the ATAK callsign /
//                            chatroom (VNAME=RNAME convention).
//   $(VTEAM)              -- lowercase team, "blue" or "red".
//                            Used to skip own flag.
//
// OPTIONAL nsplug variables (auto-derived from VTEAM below
// if not already defined upstream):
//   $(VTEAM_UPPER)        -- uppercase team, "BLUE" or "RED".
//                            Used in HAS_FLAG_<TEAM>_* names.
//   $(OPP_TEAM)           -- lowercase opposing team. Used
//                            in flag_uid for the opponent's
//                            flag marker.
//   $(DEBUG_PCOTCMD)      -- "true"/"false". Defaults to
//                            "false" if unset.
//
// REV: May 13, 2026 -- handler-class refactor
// REV: May 13, 2026 -- derive VTEAM_UPPER/OPP_TEAM from VTEAM
//                       so launch wrappers only need to set
//                       VTEAM (not all three).
//------------------------------------------------------------

//------------------------------------------------------------
// Derive VTEAM_UPPER and OPP_TEAM from VTEAM if not already
// defined upstream. nsplug doesn't do case conversion, so
// the two Aquaticus teams are listed explicitly. Add a
// branch here if you add a new team.
//
// If your nsplug version doesn't support value-matched
// #ifdef, comment this block out and add the equivalent
// -DVTEAM_UPPER=... -DOPP_TEAM=... to your launch wrapper.
//------------------------------------------------------------

#ifdef VTEAM blue
  #ifndef VTEAM_UPPER
    #define VTEAM_UPPER BLUE
  #endif
  #ifndef OPP_TEAM
    #define OPP_TEAM red
  #endif
#endif

#ifdef VTEAM red
  #ifndef VTEAM_UPPER
    #define VTEAM_UPPER RED
  #endif
  #ifndef OPP_TEAM
    #define OPP_TEAM blue
  #endif
#endif


ProcessConfig = pCoTCommander
{
  AppTick   = 4
  CommsTick = 4

  // ---- Mode ----
  fleet_mode       = false
  mission          = aquaticus
  // command_set omitted -- factory derives "vehicle" from
  // fleet_mode = false.

  // ---- Chat routing ----
  // VNAME is the ATAK callsign / chatroom (role name).
  command_chatroom = $(VNAME)
  enable_chat_commands = true

  // Optional substring filter on incoming CoT uid.
  // operator_uid_filter = ANDROID

  // ---- Diagnostics ----
  debug = $(DEBUG_PCOTCMD=false)

  //==========================================================
  // Handler-specific config
  //==========================================================

  //-- WaypointHandler (CoT b-m-p-w-GOTO from ATAK) ----------

  capture_radius          = 15.0
  waypoint_update_var     = ATAK_WPT_UPDATE
  enable_waypoint_control = true

  //-- FlagPursuitHandler (CoT b-m-p-s-m flag uid match) -----

  flag_pursuit_enabled = true

  // Opponent's flag CoT uid. OPP_TEAM derived above.
  flag_uid = aquaticus-flag-$(OPP_TEAM)

  // Our own team -- skip own flag broadcasts.
  flag_my_team = $(VTEAM)

  flag_capture_radius = 5.0

  // Pursuit terminates when ANY of these go true (teammate
  // has the flag). VTEAM_UPPER derived above.
  team_flag_vars = HAS_FLAG_$(VTEAM_UPPER)_ONE,HAS_FLAG_$(VTEAM_UPPER)_TWO,HAS_FLAG_$(VTEAM_UPPER)_THREE
}
