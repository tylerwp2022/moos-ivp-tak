//------------------------------------------------------------
// plug_pCoTCommander_vehicle.moos
//
// nsplug fragment for the per-vehicle pCoTCommander. Include
// this in each vehicle's launch configuration.
//
// Expected nsplug variables (defined upstream by the vehicle
// launch wrapper):
//   $(VNAME)              -- vehicle role name, e.g. "blue_one".
//                            Used as the ATAK callsign /
//                            chatroom (VNAME=RNAME convention).
//   $(VTEAM)              -- lowercase team, e.g. "blue".
//                            Used in flag_my_team (skip own
//                            flag) and to construct the
//                            HAS_FLAG_<TEAM>_* variable names.
//   $(VTEAM_UPPER)        -- uppercase team, e.g. "BLUE". Used
//                            in the HAS_FLAG variable list.
//   $(OPP_TEAM)           -- lowercase opposing team, e.g.
//                            "red". Used in flag_uid for the
//                            opponent's flag marker.
//   $(DEBUG_PCOTCMD)      -- optional, "true"/"false".
//                            Defaults to "false".
//
// Loads the Aquaticus vehicle bundle:
//   14 chat handlers + WaypointHandler (CoT b-m-p-w-GOTO) +
//   FlagPursuitHandler (CoT b-m-p-s-m). Total 16 handlers.
//
// REV: May 13, 2026 -- handler-class refactor
//------------------------------------------------------------

ProcessConfig = pCoTCommander
{
  AppTick   = 4
  CommsTick = 4

  // ---- Mode ----
  fleet_mode       = false
  mission          = aquaticus
  // command_set omitted -- factory derives "vehicle" from
  // fleet_mode = false.

  // ---- Chat routing ----
  // VNAME is the ATAK callsign / chatroom (role name).
  command_chatroom = $(VNAME)
  enable_chat_commands = true

  // Optional substring filter on incoming CoT uid. Typical
  // values: "ANDROID" (only accept CoT from ATAK clients),
  // "$(VNAME)" (only accept CoT addressed to this vehicle
  // via its callsign). Leave commented to accept all uids.
  // operator_uid_filter = ANDROID

  // ---- Diagnostics ----
  debug = $(DEBUG_PCOTCMD=false)

  //==========================================================
  // Handler-specific config
  //==========================================================
  // Each key is consumed only by the handler that recognizes
  // it. Other handlers ignore unknown keys silently, so this
  // section can grow without affecting unrelated handlers.

  //-- WaypointHandler (CoT b-m-p-w-GOTO from ATAK) ----------

  // BHV_Waypoint capture radius in meters.
  capture_radius = 15.0

  // MOOS variable name that the waypt_atak behavior watches
  // via its 'updates = ...' line. Must match the .bhv file.
  waypoint_update_var = ATAK_WPT_UPDATE

  // Master switch. When false, the handler is loaded but
  // claimsCoT() always returns false, so ATAK Go-To commands
  // are silently ignored.
  enable_waypoint_control = true

  //-- FlagPursuitHandler (CoT b-m-p-s-m flag uid match) -----

  flag_pursuit_enabled = true

  // Opponent's flag CoT uid. The Aquaticus referee
  // broadcasts the flag with a fixed uid; this handler
  // matches exact-equality on it.
  flag_uid = aquaticus-flag-$(OPP_TEAM)

  // Lowercase. Belt-and-suspenders defense -- if the flag
  // uid contains this team name, skip (we'd be chasing
  // our own flag).
  flag_my_team = $(VTEAM)

  // Smaller than capture_radius so we drive INTO the
  // Aquaticus grab zone rather than stopping short.
  flag_capture_radius = 5.0

  // Comma-separated list of variables to subscribe for
  // pursuit-termination. When ANY goes true a teammate
  // has the flag; pursuit ends silently.
  //
  // Naming convention: HAS_FLAG_<TEAM_UPPER>_<SLOT>. Adjust
  // if your Aquaticus setup uses a different scheme.
  team_flag_vars = HAS_FLAG_$(VTEAM_UPPER)_ONE,HAS_FLAG_$(VTEAM_UPPER)_TWO,HAS_FLAG_$(VTEAM_UPPER)_THREE
}
