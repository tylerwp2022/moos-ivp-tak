//------------------------------------------
// pCoTCommander Example MOOS Configuration
//
// pCoTCommander subscribes to COT_INBOUND (raw CoT XML published
// by pCoTBridge) and ATAK_CHAT_IN (published by pCoTChat) and
// translates operator commands from ATAK into MOOS variable
// publications for pHelmIvP behaviors.
//
// REQUIRES pCoTBridge and pCoTChat to be running on the same
// MOOSDB. pCoTCommander has no TAK server connection of its own.
//
// TWO DEPLOYMENT MODES
// ------------------------------------------------------------------
// fleet_mode = true  (SHORESIDE MOOSDB):
//   command_chatroom = AQUATICUS-SHORE (must match SHORE_CALLSIGN)
//   Posts *_ALL variables — uFldShoreBroker routes them to all
//   vehicle communities as bare variable names.
//   Prefix any command with a vehicle name to target one vehicle:
//     "deploy"          → DEPLOY_ALL=true
//     "blue_one deploy" → DEPLOY_BLUE_ONE=true
//     "attack"          → ACTION_ALL=ATTACK_MED
//     "blue_one attack" → ACTION_BLUE_ONE=ATTACK_MED
//     "blue_one atak"   → ATAK_MODE_BLUE_ONE=true
//   Vehicle names must use underscores (blue_one, not blue one).
//   play/stop are fleet-wide only (no vehicle prefix).
//
// fleet_mode = false  (VEHICLE MOOSDB):
//   command_chatroom = $(VNAME)  (this vehicle's callsign)
//   Posts bare variable names directly on this vehicle's MOOSDB.
//   In ATAK, DM the vehicle callsign to send it commands.
//   PREREQUISITE: pCoTBridge and pCoTChat must be running on the
//   vehicle (already the case in wp_2025 meta_surveyor.moos).
//
// ATAK MODE CONTROL
// ------------------------------------------------------------------
// "atak" chat command  → ATAK_MODE=true
//   Game behaviors (attack/defend/loiter) condition on
//   ATAK_MODE!=true and yield immediately. Vehicle holds
//   its current position until a waypoint or "resume" arrives.
//
// Sending a Go To waypoint from ATAK also enters ATAK mode:
//   ATAK_MODE=true + ATAK_WAYPT_ACTIVE=true are posted together
//   so the waypt_atak behavior fires on the same MOOSDB tick.
//
// "resume" chat command → ATAK_MODE=false + ATAK_WAYPT_ACTIVE=false
//   Game behaviors resume immediately on their next iterate tick.
//
// "return", "station", "pause" also clear ATAK mode.
//
// ANTLER BLOCK ENTRY
// ------------------------------------------------------------------
//   Run = pCoTCommander @ NewConsole = false
//
// Last updated: May 2026
//------------------------------------------


// ==================================================================
// SHORESIDE (fleet_mode = true)
// ==================================================================

ProcessConfig = pCoTCommander
{
  AppTick   = 4     // Iterate() fires only on new mail (COMMS_DRIVEN mode)
  CommsTick = 10    // Keep high so COT_INBOUND and ATAK_CHAT_IN arrive quickly

  // ---- Chat command interface ----
  // Operator DMs command_chatroom in ATAK. pCoTChat publishes it as
  // ATAK_CHAT_IN; pCoTCommander dispatches it.
  //
  // fleet_mode=true: posts *_ALL variables routed by uFldShoreBroker.
  //   command_chatroom must match SHORE_CALLSIGN in pCoTChat config.
  //   Prefix any command with vehicle name (underscores) to target
  //   one vehicle instead of the fleet:
  //     "atak"          → ATAK_MODE_ALL=true
  //     "blue_one atak" → ATAK_MODE_BLUE_ONE=true
  //     "resume"        → ATAK_MODE_ALL=false + ATAK_WAYPT_ACTIVE_ALL=false
  //     "attack"        → ACTION_ALL=ATTACK_MED
  //   play/stop are fleet-wide only (no vehicle prefix).
  //   Type "help" to get the full command list as a DM in ATAK.
  enable_chat_commands = true
  command_chatroom     = AQUATICUS-SHORE   // must match SHORE_CALLSIGN in pCoTChat
  fleet_mode           = true

  // ---- Waypoint control ----
  // "Go To" command (b-m-p-w-GOTO) from ATAK:
  //   1. Posts ATAK_MODE=true  (enter operator control)
  //   2. Posts ATAK_WAYPT_ACTIVE=true  (activate waypt_atak behavior)
  //   3. Posts ATAK_WPT_UPDATE="points=x,y # capture_radius=r"
  //
  // Requires in meta_surveyor.bhv:
  //   initialize ATAK_MODE         = false
  //   initialize ATAK_WAYPT_ACTIVE = false
  //
  //   Behavior = BHV_Waypoint
  //   {
  //     name      = waypt_atak
  //     pwt       = 150
  //     perpetual = true
  //     condition = ATAK_MODE = true
  //     condition = ATAK_WAYPT_ACTIVE = true
  //     condition = TAGGED != true
  //     updates   = ATAK_WPT_UPDATE
  //     endflag   = ATAK_WPT_REACHED = true
  //     ...
  //   }
  //
  // All game behaviors (attack, defend, loiter) must include:
  //   condition = ATAK_MODE != true
  enable_waypoint_control = true
  waypoint_update_var     = ATAK_WPT_UPDATE
  capture_radius          = 15.0   // meters; overridden per-waypoint at runtime

  // ---- Security ----
  // Optional: restrict CoT commands to one specific ATAK device UID.
  // Find UID in ATAK: Settings → About.
  // Leave commented to accept from any connected device.
  // operator_uid_filter = ANDROID-abc123def456

  // ---- Geodesy ----
  // Converts incoming ATAK lat/lon to MOOS-IvP local XY.
  //   false (default): MOOSGeodesy UTM projection if available,
  //                    falls back to NAV flat-earth anchor automatically.
  //   true:            always use NAV flat-earth anchor from NODE_REPORT.
  use_nav_fallback = false

  // ---- Debug ----
  // false (default): AppCast shows counters and last command only.
  // true:            verbose — every COT_INBOUND logged with type, uid,
  //                  lat/lon, and dispatch decision. Useful for verifying
  //                  ATAK targeting reaches only the intended vehicle
  //                  (check that other vehicles show ignored counts, not
  //                  handled counts, for the same test waypoint).
  debug = false
}


// ==================================================================
// VEHICLE (fleet_mode = false)
// ==================================================================
// Typically included via plug_pCoTCommander.moos from meta_surveyor.moos.
// Shown here for reference.

// ProcessConfig = pCoTCommander
// {
//   AppTick   = 4
//   CommsTick = 10
//
//   // fleet_mode=false: posts directly on this vehicle's MOOSDB.
//   // command_chatroom=$(VNAME): operator DMs the vehicle callsign
//   // in ATAK (e.g. "blue_one") to target only this vehicle.
//   fleet_mode           = false
//   command_chatroom     = $(VNAME)
//   enable_chat_commands = true
//
//   enable_waypoint_control = true
//   waypoint_update_var     = ATAK_WPT_UPDATE
//   capture_radius          = 15.0
//
//   // operator_uid_filter = ANDROID-abc123
//
//   use_nav_fallback = false
//   debug            = false
// }
//
// SUPPORTED CHAT COMMANDS (vehicle mode — DM the vehicle callsign):
//   deploy          → DEPLOY=true + overrides
//   return / rtb    → RETURN=true, ATAK_MODE=false, ATAK_WAYPT_ACTIVE=false
//   station / hold  → STATION_KEEP=true, ATAK_MODE=false, ATAK_WAYPT_ACTIVE=false
//   pause           → MOOS_MANUAL_OVERRIDE=true, ATAK_MODE=false, ATAK_WAYPT_ACTIVE=false
//   atak            → ATAK_MODE=true (enter operator control)
//   resume          → ATAK_MODE=false, ATAK_WAYPT_ACTIVE=false (back to strategy)
//   status          → DM reply with deployment state
//   attack          → ACTION=ATTACK_MED
//   defend          → ACTION=DEFEND_MED
//   attack easy     → ACTION=ATTACK_E
//   defend easy     → ACTION=DEFEND_E
//   help            → DM reply listing all commands
//   (play/stop not available in vehicle mode — fleet-wide only)
