//------------------------------------------------------------
// pCoTCommander.moos.example
//
// Example standalone configuration for pCoTCommander after
// the May 13, 2026 handler-class refactor.
//
// This file shows BOTH shoreside and vehicle modes side-by-
// side. Production deployments should use the plug files
// (plug_pCoTCommander_shore.moos / plug_pCoTCommander_vehicle.moos)
// rather than copying this verbatim.
//
// Refactor notes:
//   * fleet_mode + command_set decide which handler bundle
//     loads. command_set is optional; if absent, it's
//     derived from fleet_mode.
//   * mission selects within a bundle; only "aquaticus" is
//     registered today.
//   * Handler-specific keys (capture_radius, flag_*, etc.)
//     are consumed only by the handler that recognizes
//     them; other handlers ignore unknown keys silently.
//
// REV: May 13, 2026 -- handler-class refactor
//------------------------------------------------------------

ServerHost = localhost
ServerPort = 9000
Community  = shoreside

LatOrigin   = 41.34928
LongOrigin  = -74.063645

//------------------------------------------------------------
// Antler launch -- shore configuration shown
//------------------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB         @ NewConsole = false
  Run = pCoTCommander  @ NewConsole = false
  Run = pCoTBridge     @ NewConsole = false
  Run = pCoTChat       @ NewConsole = false
}


//============================================================
// pCoTCommander -- SHORE mode
//============================================================
//
// Shore-mode dispatcher publishes commands to *_ALL
// variables that uFldShoreBroker fans out to vehicle DBs.
// Loads the Aquaticus shore bundle: 16 chat-only handlers,
// no CoT handlers (TAK server routes operator-targeted CoT
// directly to vehicles).
//
ProcessConfig = pCoTCommander
{
  AppTick   = 4
  CommsTick = 4

  //----------------------------------------------------------
  // Dispatcher mode
  //----------------------------------------------------------

  // true  -> shoreside fleet dispatcher (publishes ACTION_ALL,
  //          AQUATICUS_GAME_ALL, etc.)
  // false -> per-vehicle dispatcher (publishes bare ACTION,
  //          activates waypt_atak, etc.)
  fleet_mode = true

  // OPTIONAL. Which handler bundle to load. If omitted, the
  // factory derives this from fleet_mode (true -> "shore",
  // false -> "vehicle"). Valid values:
  //   shore   -- Aquaticus shore bundle (16 chat-only handlers)
  //   vehicle -- Aquaticus vehicle bundle (14 chat + 2 CoT)
  //   custom  -- empty bundle; populate via enable_handler
  //
  // command_set = shore

  // Mission within the selected command_set. Default:
  // aquaticus. Future missions (e.g. hvt) would register
  // their own bundles in CommandHandlerFactory.
  mission = aquaticus

  //----------------------------------------------------------
  // Custom bundle (only honored when command_set = custom)
  //----------------------------------------------------------
  // Repeatable. Each entry adds one handler to the bundle
  // by name. Order matters for CoT dispatch (first claim
  // wins). HelpHandler should be last.
  //
  // Example -- minimal vehicle without flag pursuit:
  //   command_set = custom
  //   enable_handler = deploy
  //   enable_handler = return
  //   enable_handler = atak
  //   enable_handler = resume
  //   enable_handler = avoid
  //   enable_handler = status
  //   enable_handler = waypoint
  //   enable_handler = help

  //----------------------------------------------------------
  // Chat routing
  //----------------------------------------------------------

  // ATAK chatroom this dispatcher listens to. Chat messages
  // posted to ATAK_CHAT_IN with chatroom != this value are
  // ignored. Used as the DM fallback destination by handlers
  // that have no operator callsign to reply to.
  command_chatroom = AQUATICUS-SHORE

  // Optional substring filter on incoming CoT uid. When set,
  // CoT events whose uid does NOT contain this substring are
  // dropped before reaching handlers. Bypassed by handlers
  // that override bypassOperatorFilter() (e.g. FlagPursuit
  // accepting events from pCoTGraphics).
  // operator_uid_filter = ANDROID

  // Master switch for chat-command dispatch. CoT dispatch is
  // unaffected. Default: true.
  enable_chat_commands = true

  //----------------------------------------------------------
  // Geodesy
  //----------------------------------------------------------

  // Defaults to false. Set true to use NAV X/Y reports as a
  // fallback when MOOSGeodesy isn't available.
  // use_nav_fallback = false

  //----------------------------------------------------------
  // Diagnostics
  //----------------------------------------------------------
  debug = false

  //----------------------------------------------------------
  // Handler-specific config (consumed by the handlers that
  // recognize each key; other handlers ignore silently)
  //----------------------------------------------------------
  //
  // SHORE BUNDLE has neither WaypointHandler nor
  // FlagPursuitHandler, so the following keys are unused
  // in shore mode. Vehicle-mode example below shows them.
}


//============================================================
// pCoTCommander -- VEHICLE mode (example for reference)
//============================================================
//
// Each vehicle runs its own pCoTCommander against its local
// MOOSDB. Loads the Aquaticus vehicle bundle: 14 chat + 2
// CoT handlers (Waypoint and FlagPursuit).
//
// Uncomment and use ONE pCoTCommander block per process --
// not both at once.
//
// ProcessConfig = pCoTCommander
// {
//   AppTick   = 4
//   CommsTick = 4
//
//   fleet_mode  = false
//   mission     = aquaticus
//
//   // Vehicle's ATAK callsign. In the moos-ivp-tak
//   // convention this is VNAME (role name, e.g. "blue_one"),
//   // not the physical boat name.
//   command_chatroom = blue_one
//
//   enable_chat_commands = true
//   debug = false
//
//   //--------------------------------------------------------
//   // WaypointHandler config (b-m-p-w-GOTO from ATAK)
//   //--------------------------------------------------------
//
//   // BHV_Waypoint capture radius in meters. Default 15.
//   capture_radius = 15.0
//
//   // MOOS variable that the waypt_atak behavior reads via
//   // its 'updates = ...' line. Default: ATAK_WPT_UPDATE.
//   waypoint_update_var = ATAK_WPT_UPDATE
//
//   // Master switch for waypoint dispatch. False disables
//   // claimsCoT() in WaypointHandler -- the handler is
//   // still loaded but never claims events. Default: true.
//   enable_waypoint_control = true
//
//   //--------------------------------------------------------
//   // FlagPursuitHandler config (b-m-p-s-m flag CoT)
//   //--------------------------------------------------------
//
//   flag_pursuit_enabled = true
//
//   // Exact CoT uid this handler matches on. The Aquaticus
//   // referee broadcasts the opponent's flag with this uid.
//   flag_uid = aquaticus-flag-red
//
//   // Lowercase. Belt-and-suspenders -- if the flag uid
//   // contains this team name, skip it (we'd be chasing our
//   // own flag).
//   flag_my_team = blue
//
//   // Smaller than capture_radius so we drive INTO the
//   // Aquaticus grab zone rather than stopping short.
//   flag_capture_radius = 5.0
//
//   // Comma-separated. Handler subscribes to each. When ANY
//   // goes true, a teammate has secured the flag and
//   // pursuit ends.
//   team_flag_vars = HAS_FLAG_BLUE_ONE,HAS_FLAG_BLUE_TWO,HAS_FLAG_BLUE_THREE
// }
