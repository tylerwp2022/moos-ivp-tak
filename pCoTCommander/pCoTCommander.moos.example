//------------------------------------------------------------------
// pCoTCommander_moos.example
//
// Example MOOS configuration for pCoTCommander.
// Covers both fleet (shoreside) and vehicle modes.
//
// pCoTCommander translates operator commands from ATAK into MOOS
// variable publications for pHelmIvP behaviors. It requires
// pCoTBridge (publishes COT_INBOUND) and pCoTChat (publishes
// ATAK_CHAT_IN) to be running on the same MOOSDB.
//
// TWO DEPLOYMENT MODES
// ------------------------------------------------------------------
// fleet_mode = true  (SHORESIDE MOOSDB):
//   Posts *_ALL variables -- uFldShoreBroker routes to all vehicles.
//   Chatroom = AQUATICUS-SHORE (must match SHORE_CALLSIGN in pCoTChat)
//   Prefix any command with a vehicle name to target one vehicle:
//     "atak"               -> ATAK_MODE_ALL=true
//     "blue_one atak"      -> ATAK_MODE_BLUE_ONE=true
//     "resume"             -> ATAK_MODE_ALL=false
//     "avoid off"          -> ATAK_AVOID_COLLISIONS_ALL=false
//     "blue_one retry off" -> ATAK_RETRY_BLUE_ONE=false
//     "attack"             -> ACTION_ALL=ATTACK_MED
//     "blue_one attack"    -> ACTION_BLUE_ONE=ATTACK_MED
//   Vehicle names must use underscores (blue_one, not blue one).
//   play/stop are fleet-wide only (no vehicle prefix).
//
// fleet_mode = false  (VEHICLE MOOSDB):
//   Posts bare variable names directly on the vehicle's MOOSDB.
//   Chatroom = $(VNAME) -- operator DMs the vehicle callsign.
//   Use plug_pCoTCommander.moos included from meta_surveyor.moos.
//
// ATAK MODE
// ------------------------------------------------------------------
// "atak" or any incoming waypoint -> ATAK_MODE=true
//   Game behaviors yield (they condition on ATAK_MODE != true).
//   Vehicle holds position until a waypoint or "resume" arrives.
//
// "resume" -> ATAK_MODE=false + ATAK_WAYPT_ACTIVE=false
//   Game behaviors resume immediately on next helm tick.
//
// "return", "station", "pause" also exit ATAK mode.
//
// BEHAVIOR TOGGLES (all default on, vehicle or fleet mode)
// ------------------------------------------------------------------
//   avoid on|off  -> ATAK_AVOID_COLLISIONS = true|false
//     Gates BHV_AvdColregsV22 and BHV_AvoidCollision in ATAK mode.
//
//   untag on|off  -> ATAK_AUTO_UNTAG = true|false
//     on:  vehicle auto-returns home when tagged, then resumes waypoint
//     off: vehicle ignores tags, stays on ATAK waypoint
//
//   retry on|off  -> ATAK_RETRY = true|false
//     on:  after tag recovery waypt_atak reactivates automatically
//     off: after tag recovery ATAK_WAYPT_ACTIVE is cleared; operator
//          gets a DM and must send a new waypoint to continue
//
//   opreg on|off  -> ATAK_OPREG_RECOVER = true|false
//     Gates BHV_OpRegionRecover (boundary enforcement) in ATAK mode.
//     WARNING DM sent when turned off. Always active in auto mode.
//
// WAYPOINT INTERFACE
// ------------------------------------------------------------------
// In ATAK use "Send To <vehicle>" to target a specific boat.
// TAK server routes b-m-p-w-GOTO only to that vehicle's pCoTBridge.
// pCoTCommander converts lat/lon -> local XY and posts:
//   ATAK_MODE         = true
//   ATAK_WAYPT_ACTIVE = true
//   ATAK_WPT_UPDATE   = points=x,y # capture_radius=r
//
// Rejection cases (DM sent explaining why):
//   DEPLOY=false  -> "not deployed, send 'deploy' first"
//   No GPS yet    -> "waiting for GPS fix"
//   Bad CoT       -> "missing coordinates in GoTo"
//
// Required in meta_surveyor.bhv:
//   initialize ATAK_MODE              = false
//   initialize ATAK_WAYPT_ACTIVE      = false
//   initialize ATAK_AVOID_COLLISIONS  = true
//   initialize ATAK_AUTO_UNTAG        = true
//   initialize ATAK_OPREG_RECOVER     = true
//
//   Behavior = BHV_Waypoint
//   {
//     name      = waypt_atak
//     pwt       = 100            // recover (300) and colregs (300) dominate
//     perpetual = true
//     condition = ATAK_MODE = true
//     condition = ATAK_WAYPT_ACTIVE = true
//     condition = (TAGGED != true) or (ATAK_AUTO_UNTAG = false)
//     updates   = ATAK_WPT_UPDATE
//     endflag   = ATAK_WPT_REACHED = true
//     speed          = 3.5
//     capture_radius = 15.0
//     slip_radius    = 30.0
//     runflag = BOT_DIALOG_STATUS=ATAK Waypoint
//   }
//
//   // All game behaviors must include:
//   condition = ATAK_MODE != true
//
//   // common.bhv BHV_OpRegionRecover must include:
//   condition = (ATAK_MODE = false) or (ATAK_OPREG_RECOVER = true)
//
//   // common.bhv BHV_AvdColregsV22 must include:
//   condition = (ATAK_MODE = false) or (ATAK_AVOID_COLLISIONS = true)
//
// Last updated: May 2026 (updated)
//------------------------------------------------------------------


// ==================================================================
// SHORESIDE (fleet_mode = true)
// ==================================================================

ProcessConfig = pCoTCommander
{
  AppTick   = 4     // COMMS_DRIVEN -- fires on new mail only
  CommsTick = 10    // Keep high so COT_INBOUND arrives promptly

  // ---- Chat command interface ----
  // Operator DMs command_chatroom in ATAK. pCoTChat publishes it as
  // ATAK_CHAT_IN; pCoTCommander dispatches and confirms via DM.
  // fleet_mode=true: posts *_ALL vars routed by uFldShoreBroker.
  // Prefix any command with vehicle name (underscores) to target one.
  enable_chat_commands = true
  command_chatroom     = AQUATICUS-SHORE   // must match SHORE_CALLSIGN
  fleet_mode           = true

  // ---- Waypoint control ----
  enable_waypoint_control = true
  waypoint_update_var     = ATAK_WPT_UPDATE
  capture_radius          = 15.0   // meters

  // Optional: restrict to one ATAK device UID.
  // Find UID in ATAK: Settings -> About.
  // operator_uid_filter = ANDROID-abc123

  use_nav_fallback = false
  debug            = false
}


// ==================================================================
// VEHICLE (fleet_mode = false)
// ==================================================================
// Use plug_pCoTCommander.moos rather than this block directly.
// Shown here for reference.

// ProcessConfig = pCoTCommander
// {
//   AppTick   = 4
//   CommsTick = 10
//
//   fleet_mode           = false
//   command_chatroom     = $(VNAME)   // vehicle callsign
//   enable_chat_commands = true
//
//   enable_waypoint_control = true
//   waypoint_update_var     = ATAK_WPT_UPDATE
//   capture_radius          = 15.0
//
//   // operator_uid_filter = ANDROID-abc123
//
//   use_nav_fallback = false
//   debug            = false
// }
//
// VEHICLE CHAT COMMANDS (DM the vehicle callsign):
//   deploy          -> DEPLOY=true + overrides
//   return / rtb    -> RETURN=true, exits ATAK mode
//   station / hold  -> STATION_KEEP=true, exits ATAK mode
//   pause           -> MOOS_MANUAL_OVERRIDE=true, exits ATAK mode
//   atak            -> ATAK_MODE=true (enter operator control)
//   resume          -> ATAK_MODE=false (back to autonomous strategy)
//   avoid on|off    -> ATAK_AVOID_COLLISIONS=true|false
//   untag on|off    -> ATAK_AUTO_UNTAG=true|false
//   retry on|off    -> ATAK_RETRY=true|false
//   opreg on|off    -> ATAK_OPREG_RECOVER=true|false (warning on off)
//   status          -> DM: deployment + ATAK state
//   attack          -> ACTION=ATTACK_MED
//   defend          -> ACTION=DEFEND_MED
//   attack easy     -> ACTION=ATTACK_E
//   defend easy     -> ACTION=DEFEND_E
//   help            -> DM: vehicle command list
//   (play/stop not available -- fleet-wide only via shoreside)
