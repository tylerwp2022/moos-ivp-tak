// ============================================================
// pCoTBridge_moos.example
//
// pCoTBridge is a pure CoT transport layer. It maintains a
// TCP/TLS connection to a TAK server and moves bytes in both
// directions:
//
//   COT_OUTBOUND (MOOSDB) → TAK server
//   TAK server → COT_INBOUND (MOOSDB)
//
// pCoTBridge does NOT generate CoT. Vehicle SA contacts,
// map graphics, and chat are produced by sibling apps and
// posted to COT_OUTBOUND:
//
//   pCoTContact      → vehicle SA position contacts
//   pCoTShoreContact → static position contacts (shore station)
//   pCoTGraphics     → VIEW_* map overlays
//   pCoTChat         → GeoChat messages
//
// See pCoTContact.moos.example for vehicle contact config.
// ============================================================


// ============================================================
// Minimal config — plain TCP (port 8088, no certificates)
// ============================================================

ProcessConfig = pCoTBridge
{
  AppTick   = 4
  CommsTick = 4

  tak_host = 192.168.0.38
  tak_port = 8088          // 8088 = plain TCP, 8089 = mTLS

  reconnect_interval = 5.0    // seconds between reconnect attempts
  cot_delimiter      = newline // FreeTAKServer: newline | WinTAK: null

  debug = false
}


// ============================================================
// mTLS config — encrypted connection (port 8089)
//
// TLS is enabled automatically when tak_port = 8089.
// Place certificate files in pCoTBridge/certs/:
//
//   shoreside.pem          — client certificate
//   shoreside.key          — client private key
//   shoreside-trusted.pem  — CA certificate (BEGIN TRUSTED CERTIFICATE)
//
// If the private key is passphrase-protected
// (BEGIN ENCRYPTED PRIVATE KEY), set tls_key_pass.
// OpenSSL decrypts the key in memory — no plaintext
// key file is written to disk.
// ============================================================

// ProcessConfig = pCoTBridge
// {
//   AppTick   = 4
//   CommsTick = 4
//
//   tak_host = 192.168.0.38
//   tak_port = 8089          // TLS enabled automatically on 8089
//
//   tls_cert_file = certs/shoreside.pem
//   tls_key_file  = certs/shoreside.key
//   tls_ca_file   = certs/shoreside-trusted.pem
//   tls_key_pass  = atakatak  // omit if key is not passphrase-protected
//
//   reconnect_interval = 5.0
//   cot_delimiter      = newline
//
//   debug = false
// }
